# GitHub fine-grained personal access token with read-only access to public repositories.
# Copy this file to .env.local and paste your token. Never commit .env.local.
GITHUB_TOKEN=

# Optional: Upstash Redis (REST API) for the shared cache, request coalescing
# and rate limiting. Without these the app uses an in-memory store.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
